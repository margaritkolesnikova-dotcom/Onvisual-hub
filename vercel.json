{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/telegram-digest",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/zoom-daily",
      "schedule": "15 5 * * *"
    }
  ],
  "functions": {
    "api/zoom-daily.js": {
      "maxDuration": 300
    },
    "api/meeting-archive.js": {
      "maxDuration": 300
    }
  }
}
